# ats-strike client configuration: cv.toml, in your data folder.
#
# ats-strike reads it from the folder you run it in, from --data-dir, or from
# the path you give to --config.

# The server that analyses every posting and writes the cover letter: one of
# the [servers.<name>] sections below. Optional while only one is configured.
# default_server = "v11"

# Write a cover letter too: "no" | "yes" | "letter_only". The default server
# writes it.
cover_letter = "no"

# Print what each server reports about each step, and every line it logs.
verbose = false

# One section per server. Its name is the name --server_ver takes and the
# suffix its PDFs get.
[servers.v11]

# The folder that holds every file this server is sent, relative to this
# file, sub-folders included:
#   candidate_profile.json  candidate_data.json  candidate_preferences.md
#   candidate_signature.png  and any sys_prompt_*.txt, *_schema.json,
#   resume.tex.jinja or image you want used instead of the server's own.
#   cache/ is the server's: it fills it itself.
# Two servers may share a folder.
folder = "v11"

url = "http://localhost:8080"

# Only if the server requires one (it answers 401 without it).
# token = "..."

# How long to follow a CV job, in seconds. Writing one takes minutes.
# timeout = 1800

# Sent with every request as it is: what it means is the server's business.
# These are the 1.x server's.
# [servers.v11.settings]
# pages = 2                     # page limit the CV must fit (default 2)
#
# A model role's request settings instead of the server's: replaces ALL of
# that role's settings in the server's models.toml for the request. Roles:
# jd_evaluation, profile_scoring, format_selection, cv, duties, validation,
# highlight (the CV), analysis and letter.
# [servers.v11.settings.extra_body.cv]
# temperature = 0.4
